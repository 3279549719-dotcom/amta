#!/bin/sh
# Level 3 pre-push gate: full local checks (fastcheck + optional smoke if koharu reachable).
# Install: scripts/install_hooks.ps1 (git config core.hooksPath .githooks)
set -e
cd "$(dirname "$0")/.."
command -v python >/dev/null 2>&1 && PY=python || PY=py

echo "[pre-push] fastcheck (compile + ruff + pyright + unit tests)..."
$PY scripts/fastcheck.py

echo "[pre-push] optional smoke (only if koharu reachable)..."
if $PY -c "import requests,sys; sys.exit(0 if requests.get('http://127.0.0.1:4000/', timeout=2).ok else 1)" 2>/dev/null; then
    $PY scripts/smoke_test.py
else
    echo "[pre-push] koharu unreachable, skip smoke (push continues; run npm start when needed)"
fi

echo "[pre-push] OK"
