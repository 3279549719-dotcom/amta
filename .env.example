# Public template only. Copy to .env and supply secrets privately.
# get_chat_config reads these three from process environment or .env.
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=

# Optional workbench VLM OCR. Key is read from process environment or .env.
DASHSCOPE_API_KEY=

# The following are PROCESS environment variables, not automatically loaded
# from .env by the current implementation. Set them in your launcher/shell.
# HAYAI_OCR_MODEL=/absolute/path/to/amta/models/hayai-ocr-v2
# VISION_MODEL=qwen3.5-omni-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PHOTOSHOP_PATH=C:\Program Files\Adobe\Adobe Photoshop 2025\Photoshop.exe
# No LAMA_MANGA_MODEL variable is wired into the current code.
