{
  "name": "amta",
  "version": "0.1.0",
  "description": "AMTA — Automation Manga Translate Agent：全本地漫画翻译管线（detect/ocr/inpaint/typeset 纯本地，仅 translate 走 LLM API）",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start_koharu.ps1",
    "koharu:check": "powershell -ExecutionPolicy Bypass -File scripts/precheck.ps1",
    "check": "uv run python scripts/fastcheck.py --quick",
    "finish": "uv run python scripts/state.py finish",
    "hooks:install": "powershell -ExecutionPolicy Bypass -File scripts/install_hooks.ps1"
  },
  "dependencies": {}
}
