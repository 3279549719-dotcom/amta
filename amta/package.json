{
  "name": "amta",
  "version": "0.1.0",
  "description": "AMTA — Automation Manga Translate Agent：本地 koharu v0.59.1 headless（端口 4000）驱动的漫画翻译自动化编排层（Python）",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start_koharu.ps1",
    "precheck": "powershell -ExecutionPolicy Bypass -File scripts/precheck.ps1",
    "smoke": "python scripts/smoke_test.py",
    "check": "python -m compileall -q src scripts",
    "test": "python -m unittest discover -s tests -v",
    "lint": "python -m ruff check src scripts tests",
    "typecheck": "pyright src",
    "fastcheck": "python scripts/fastcheck.py",
    "finish": "npm run check && npm run test",
    "audit": "python scripts/audit.py",
    "hooks:install": "powershell -ExecutionPolicy Bypass -File scripts/install_hooks.ps1",
    "bench": "python src/benchmark.py --all",
    "bench:a": "python src/benchmark.py --bench a --pages",
    "bench:b": "python src/benchmark.py --bench b --pages",
    "bench:c": "python src/benchmark.py --bench c --pages",
    "ingest:a": "python src/benchmark.py --bench a --ingest",
    "prescreen": "python src/benchmark.py --bench a --prescreen --pages",
    "recall:detect": "python src/recall_detect.py",
    "recall:score": "python src/recall_score.py"
  },
  "dependencies": {}
}
