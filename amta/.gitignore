# ---- Node / npm ----
node_modules/

# ---- Python ----
__pycache__/
*.pyc
.venv*
*.egg-info/
.pytest_cache/

# ---- 本地密钥 / 配置 ----
.env
.env.local
*.local
# DSH agent-instructions 自动注入的本地 overlay（记忆包，生成物，不入库）
AGENTS.local.md
CLAUDE.local.md

# ---- 产物目录（默认忽略，特定数据文件例外）----
output/*
!output/.gitkeep
!output/data/labels_a.json
!output/data/label_manifest.json
!output/data/ocr_result.json

# ---- 模型权重 / 参考克隆（大文件，不入库）----
models/

# ---- 测试集页面（大图片，不入库，见 testsets/README.md）----
testsets/pages/

# ---- 记忆包 / 缓存 ----
.remember/

# ---- VCS ----
.git/

# ---- git worktree 隔离目录 ----
.worktrees/

# ---- per-work 产物（ADR-013：raw/artifacts/state JSON 不入库）----
workspace/*/raw/
workspace/*/artifacts/

# ---- workstate 动态目录（init_workspace 创建，不入库）----
workspace/ws-*/

# SDD workspace (superpowers subagent-driven ledger, 不入库)
.superpowers/

# ---- realrun 备份 ----
workspace/*/backup*/

# DSH agent-teams 运行时状态(不入库)
.agent-teams/

# workspace 大产物
workspace/
