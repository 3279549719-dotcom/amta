#!/bin/sh
# Level 2 — pre-commit 门禁：快速确定性校验（秒级，不连 koharu）。
# 安装：scripts/install_hooks.ps1（git config core.hooksPath .githooks）
set -e
cd "$(dirname "$0")/.."
command -v python >/dev/null 2>&1 && PY=python || PY=py

echo "[pre-commit] fastcheck (compile + unit tests + output schema)..."
$PY scripts/fastcheck.py

echo "[pre-commit] OK"
