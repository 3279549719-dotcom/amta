    "page_4": {
      "det_key": "page_3",
      "regions": [
        {
          "content": "そういえばサグメってどんな研究してるの？",
          "type": "dialogue_in",
          "match_score": 1.0,
          "recalled": true,
          "best_det": 1.0
        },
        {
          "content": "わわわ",
          "type": "sfx",
          "match_score": 1.0,
          "recalled": true,
          "best_det": 1.0
        },
        {
          "content": "くるっ",
          "type": "sfx",
          "match_score": 1.0,
          "recalled": true,
          "best_det": 1.0
        },
        {
          "content": "むすっ",
          "type": "sfx",
          "match_score": 1.0,
          "recalled": true,
          "best_det": 1.0
        },
        {
          "content": "ちゅー",
          "type": "sfx",
          "match_score": 1.0,
          "recalled": true,
          "best_det": 1.0
        },
        {
          "content": "他者に興味のある月の民など異常だ",
          "type": "dialogue_out",
          "match_score": 1.0,
          "recalled": true,
          "best_det": 1.0
        },
        {
          "content": "だからこの人とは一度も話したことはなかったし、これからも話すことはないと思っていた",
          "type": "dialogue_out",
          "match_score": 1.0,
          "recalled": true,
          "best_det": 1.0
        },
        {
          "content": "ちょっと、大丈夫",
