          "match_score": 1.0,
          "recalled": true,
          "best_det": 1.0
        },
        {
          "content": "お姫様のもとから戻ってきた八意様は明らかに以前とは変わっていた",
          "type": "dialogue_out",
          "match_score": 1.0,
